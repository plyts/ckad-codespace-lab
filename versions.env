# Versions figées du labo. Source unique : tous les scripts lisent ce fichier.
# Vérifiées le 2026-11-25 (voir versions.md pour les sources et la procédure de mise à jour).
KIND_VERSION=v0.33.0
KUBECTL_VERSION=v1.37.0
K8S_VERSION=v1.37.0
K8S_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
HELM_VERSION=v3.19.0
YQ_VERSION=v4.50.1
TRAEFIK_IMAGE=traefik:v3.7.20
METRICS_SERVER_VERSION=v0.8.0
METRICS_SERVER_IMAGE=registry.k8s.io/metrics-server/metrics-server:v0.8.0
# Miroir Docker Hub de Google : évite la limite de débit (429) de Docker Hub.
IMAGE_MIRROR=mirror.gcr.io
# Images utilisées par les exercices, préchargées dans les nœuds kind (kind load).
LAB_IMAGES="busybox:1.37 nginx:1.27-alpine nginx:1.28-alpine redis:7.4-alpine hashicorp/http-echo:1.0.0 traefik:v3.7.20"
