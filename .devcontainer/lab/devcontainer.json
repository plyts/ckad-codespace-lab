// Configuration « lab » : travailler dans VS Code (navigateur), terminal + clusters kind.
// Aucune extension d'IA ; chat.disableAIFeatures coupe Copilot et le chat de VS Code.
{
  "name": "CKAD lab",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" }
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "containerEnv": { "MODE": "lab" },
  "remoteEnv": { "PATH": "${containerWorkspaceFolder}/bin:${containerEnv:PATH}" },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "forwardPorts": [8000, 8080],
  "portsAttributes": {
    "8000": { "label": "Guide HTML (site)", "onAutoForward": "silent" },
    "8080": { "label": "Ingress Traefik (ckad-a)", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "chat.disableAIFeatures": true,
        "github.copilot.enable": { "*": false },
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    },
    "codespaces": { "openFiles": ["README.md"] }
  }
}
